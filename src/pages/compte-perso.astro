---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const CAL_URL = import.meta.env.CAL_URL ?? 'https://cal.eu/alliance-digitale/decouverte-30-min';

const fonctionnalites = [
  {
    titre: 'Photo du ticket → dépense enregistrée',
    texte: 'Photographiez votre ticket de caisse depuis Telegram : le montant, la date et le magasin sont lus automatiquement, la catégorie vous est proposée, vous validez en un clic.',
  },
  {
    titre: 'Import du relevé bancaire',
    texte: 'Déposez le PDF de votre relevé : les opérations sont importées et vérifiées à l\'euro près. Le total contrôlé doit correspondre exactement, sinon rien n\'est importé.',
  },
  {
    titre: 'Enveloppes budgétaires',
    texte: 'Alimentation, essence, loisirs… chaque dépense va dans son enveloppe. Vous voyez en un coup d\'œil ce qui reste avant la fin du mois.',
  },
  {
    titre: 'Alertes en temps réel',
    texte: 'Dépassement d\'enveloppe, prélèvement inhabituel, écart avec le relevé : vous êtes prévenu sur Telegram au moment où ça arrive, pas à la fin du mois.',
  },
  {
    titre: 'Rapprochement automatique',
    texte: 'Vos tickets photographiés sont rapprochés automatiquement des lignes du relevé bancaire. Ce qui reste en attente est visible d\'un coup d\'œil.',
  },
  {
    titre: 'Synthèses sur 12 mois',
    texte: 'Bilan mensuel et historique complet : où va votre argent, par enveloppe, avec l\'évolution sur l\'année.',
  },
  {
    titre: 'Récapitulatif hebdomadaire',
    texte: 'Chaque lundi, un résumé clair de la semaine par email : ce que vous avez dépensé, ce qui reste dans chaque enveloppe.',
  },
  {
    titre: 'Sécurité renforcée',
    texte: 'Double authentification à chaque connexion, données hébergées en Europe, session verrouillée après plusieurs échecs.',
  },
];

const faq = [
  {
    q: 'Mes données bancaires sont-elles en sécurité ?',
    a: 'L\'application ne se connecte jamais à votre banque. Vous importez vous-même le PDF de votre relevé, qui est vérifié à l\'euro près avant enregistrement. Vos données sont hébergées en Europe et l\'accès est protégé par mot de passe et double authentification.',
  },
  {
    q: 'Avec quelle banque ça fonctionne-t-il ?',
    a: 'L\'application fonctionne avec l\'import de relevés au format PDF ou CSV — le format standard des relevés mensuels. Elle a été conçue et éprouvée avec les relevés de la Caisse d\'Épargne ; si votre banque fournit des relevés PDF ou CSV, cela fonctionne de la même manière.',
  },
  {
    q: 'Est-ce que ça marche à deux ?',
    a: 'Oui — c\'est même conçu pour ça. Deux personnes peuvent suivre le budget commun : chacun photographie ses tickets depuis son téléphone, les deux voient l\'état des enveloppes et reçoivent leurs alertes.',
  },
  {
    q: 'Faut-il connecter Telegram ?',
    a: 'Telegram est optionnel mais recommandé : c\'est lui qui porte les alertes en temps réel et le scan de tickets par photo. Sans Telegram, l\'application reste utilisable entièrement depuis le navigateur.',
  },
  {
    q: 'Y a-t-il un engagement ?',
    a: 'Non. L\'abonnement est mensuel, sans engagement, résiliable à tout moment. Vos données restent les vôtres.',
  },
  {
    q: 'Comment commencer ?',
    a: 'Réservez une démo de 30 minutes : on configure votre compte avec vos enveloppes à vous, et vous êtes opérationnel le jour même.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const appLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Compte Perso',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web, iOS, Android',
  description: 'Application de comptabilité personnelle : tickets photographiés, relevés importés et vérifiés, enveloppes budgétaires et alertes en temps réel.',
  offers: {
    '@type': 'Offer',
    price: '9.90',
    priceCurrency: 'EUR',
    description: 'Abonnement mensuel sans engagement',
    availability: 'https://schema.org/InStock',
  },
  publisher: { '@type': 'Organization', name: 'Alliance Digitale' },
};
---

<Layout
  title="Compte Perso — vos comptes personnels, photo de ticket près | Alliance Digitale"
  description="Scannez vos tickets, importez vos relevés, suivez vos enveloppes budgétaires avec alertes en temps réel. 9,90 €/mois sans engagement."
  image="/images/solutions/compte-perso.webp"
  jsonLd={[appLd, faqLd]}
>
  <Header />

  <main class="flex-1">
    <!-- Hero produit -->
    <section class="relative overflow-hidden">
      <div class="mx-auto max-w-7xl px-4 pt-16 pb-12 grid gap-10 lg:grid-cols-2 lg:items-center">
        <div>
          <p class="inline-flex items-center px-3 py-1 rounded-full bg-alliance-orange text-white text-xs font-bold uppercase tracking-widest" data-hero-anim>Nouveau</p>
          <h1 class="mt-4 font-display text-4xl md:text-5xl font-bold text-white" data-hero-anim>Compte Perso</h1>
          <p class="mt-4 text-xl text-white/75" data-hero-anim>
            Vos comptes personnels, tenus à la photo de ticket près.
          </p>
          <p class="mt-4 text-white/65 leading-relaxed" data-hero-anim>
            Photographiez vos tickets, importez vos relevés, laissez le rapprochement se faire tout seul.
            Vous voyez en permanence ce qu'il reste dans chaque enveloppe — et vous êtes alerté avant de déraper.
          </p>
          <div class="mt-8 flex items-baseline gap-2" data-hero-anim>
            <span class="font-display text-4xl font-bold text-alliance-blue">9,90 €</span>
            <span class="text-white/60">/ mois · sans engagement</span>
          </div>
          <div class="mt-6 flex flex-col sm:flex-row gap-4" data-hero-anim>
            <a href={CAL_URL} class="btn-primary px-8 py-3 rounded-lg font-semibold text-center">Voir la démo en 30 min</a>
            <a href="#fonctionnalites" class="px-8 py-3 rounded-lg font-semibold border border-white/20 text-white/80 hover:text-white hover:border-white/40 transition text-center">Voir les fonctionnalités</a>
          </div>
        </div>
        <div class="rounded-3xl overflow-hidden border border-white/10 shadow-2xl" data-reveal>
          <img
            src="/images/solutions/compte-perso.webp"
            alt="Photographie d'un ticket de caisse avec le tableau de budget sur tablette à côté"
            width="1024"
            height="768"
            loading="eager"
            decoding="async"
            class="w-full aspect-[4/3] object-cover"
          />
        </div>
      </div>
    </section>

    <!-- Comment ça marche -->
    <section class="mx-auto max-w-7xl px-4 py-16">
      <h2 class="font-display text-3xl font-bold text-white" data-reveal>Comment ça marche</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {
          [
            {
              n: '1',
              t: 'Vous photographiez vos tickets',
              d: 'Depuis Telegram, envoyez la photo du ticket : le montant, la date et le magasin sont lus automatiquement, vous validez la catégorie en deux clics.',
            },
            {
              n: '2',
              t: 'Vous déposez votre relevé',
              d: 'À réception du relevé mensuel, déposez le PDF dans l\'application : les opérations sont importées et contrôlées à l\'euro près.',
            },
            {
              n: '3',
              t: 'Tout est rapproché',
              d: 'Les tickets se rapprochent automatiquement des lignes du relevé. Ce qui reste à vérifier est visible d\'un coup d\'œil.',
            },
          ].map((etape) => (
            <div class="rounded-2xl bg-alliance-dark-2 border border-white/10 p-6" data-reveal>
              <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-alliance-blue/15 text-alliance-blue font-display font-bold text-lg">{etape.n}</span>
              <h3 class="mt-4 font-semibold text-white text-lg">{etape.t}</h3>
              <p class="mt-2 text-sm text-white/70 leading-relaxed">{etape.d}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Fonctionnalités -->
    <section id="fonctionnalites" class="mx-auto max-w-7xl px-4 py-16">
      <h2 class="font-display text-3xl font-bold text-white" data-reveal>Tout ce que l'application fait pour vous</h2>
      <div class="mt-8 grid gap-5 md:grid-cols-2">
        {
          fonctionnalites.map((f) => (
            <div class="rounded-2xl bg-alliance-dark-2 border border-white/10 p-6" data-reveal>
              <h3 class="font-semibold text-white">{f.titre}</h3>
              <p class="mt-2 text-sm text-white/70 leading-relaxed">{f.texte}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Offre -->
    <section class="mx-auto max-w-7xl px-4 py-10">
      <div class="rounded-3xl border border-alliance-blue/30 bg-gradient-to-br from-alliance-dark-2 to-alliance-dark p-8 md:p-10 md:flex items-center justify-between gap-8" data-reveal>
        <div>
          <h2 class="font-display text-2xl md:text-3xl font-bold text-white">Un tarif simple : 9,90 € par mois</h2>
          <ul class="mt-4 space-y-2 text-white/75 text-sm md:text-base">
            <li class="flex items-start gap-2"><span class="text-alliance-blue mt-0.5">✓</span> Sans engagement, résiliable à tout moment</li>
            <li class="flex items-start gap-2" ><span class="text-alliance-blue mt-0.5">✓</span> Mise en place et configuration incluses, avec vos enveloppes à vous</li>
            <li class="flex items-start gap-2"><span class="text-alliance-blue mt-0.5">✓</span> Vos données hébergées en Europe, double authentification</li>
          </ul>
        </div>
        <div class="mt-6 md:mt-0 shrink-0 text-center">
          <a href={CAL_URL} class="btn-primary px-8 py-3 rounded-lg font-semibold inline-block">Réserver ma mise en place</a>
          <p class="mt-3 text-xs text-white/50">Démo de 30 minutes, sans engagement</p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mx-auto max-w-3xl px-4 py-16">
      <h2 class="font-display text-3xl font-bold text-white" data-reveal>Questions fréquentes</h2>
      <div class="mt-8 space-y-4">
        {
          faq.map((f) => (
            <details class="group rounded-2xl bg-alliance-dark-2 border border-white/10 p-5" data-reveal>
              <summary class="flex cursor-pointer items-center justify-between font-semibold text-white list-none">
                {f.q}
                <svg class="w-5 h-5 shrink-0 text-alliance-blue transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <p class="mt-3 text-sm text-white/70 leading-relaxed">{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <!-- CTA final -->
    <section class="mx-auto max-w-7xl px-4 pb-20 text-center">
      <h2 class="font-display text-2xl md:text-3xl font-bold text-white" data-reveal>Reprenons le contrôle du budget</h2>
      <p class="mt-3 text-white/70" data-reveal>Une démo de 30 minutes suffit pour tout configurer avec vous.</p>
      <a href={CAL_URL} class="btn-primary mt-6 inline-block px-8 py-3 rounded-lg font-semibold" data-reveal>Prendre rendez-vous</a>
    </section>
  </main>

  <Footer />
</Layout>
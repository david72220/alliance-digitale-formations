---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const CAL_URL = import.meta.env.CAL_URL ?? 'https://cal.eu/alliance-digitale/decouverte-30-min';
---

<Layout
  title="Réputia — transformez vos clients satisfaits en avis Google | Alliance Digitale"
  description="Demande d'avis automatique après prestation, filtrage des mécontents en privé, réponse à tous les avis, tableau de bord. En préparation — prévenez-moi à la sortie."
  image="/images/solutions/reputia.webp"
>
  <Header />
  <main class="flex-1">
    <!-- Hero -->
    <section class="relative overflow-hidden bg-alliance-dark-2">
      <div class="relative mx-auto max-w-7xl px-4 pt-16 pb-14 grid gap-10 lg:grid-cols-2 lg:items-center">
        <div>
          <p class="inline-flex items-center px-3 py-1 rounded-full bg-white/10 text-white/90 text-xs font-bold uppercase tracking-widest border border-white/20" data-hero-anim>Bientôt — en préparation</p>
          <h1 class="mt-4 font-display text-4xl md:text-5xl font-bold text-white" data-hero-anim>Réputia</h1>
          <p class="mt-3 text-xl text-white/80" data-hero-anim>Chaque client satisfait devient un avis Google.</p>
          <p class="mt-4 text-white/65 leading-relaxed" data-hero-anim>
            Deux heures après la prestation, votre client reçoit une demande d'avis simple.
            Mécontent ? Il est orienté en privé vers vous, et non vers la note publique.
            Vous répondez à chaque avis, et vous voyez où vous en êtes face aux concurrents.
          </p>
          <div class="mt-6 rounded-2xl border border-white/15 bg-alliance-dark p-5" data-hero-anim>
            <p class="text-white/80 font-semibold">Tarifs prévus</p>
            <ul class="mt-2 space-y-1 text-sm text-white/65">
              <li>Essentiel : 49 €/mois · Premium : 69 €/mois</li>
              <li>Installation offerte (engagement de 6 mois)</li>
            </ul>
            <p class="mt-2 text-xs text-white/45">Offre en préparation — les tarifs définitifs seront confirmés à la sortie.</p>
          </div>
          <div class="mt-6 flex flex-col sm:flex-row gap-4" data-hero-anim>
            <a href="/contact/" class="btn-primary px-8 py-3 rounded-lg font-semibold text-center">Me prévenir à la sortie</a>
          </div>
        </div>
        <div class="rounded-3xl overflow-hidden border border-white/10 shadow-2xl" data-reveal>
          <img
            src="/images/solutions/reputia.webp"
            alt="Restaurateur consultant les avis de ses clients sur son téléphone"
            width="1024"
            height="768"
            loading="eager"
            decoding="async"
            class="w-full aspect-[4/3] object-cover"
          />
        </div>
      </div>
    </section>

    <!-- Ce que fera Réputia -->
    <section class="mx-auto max-w-7xl px-4 py-16">
      <h2 class="font-display text-3xl font-bold text-white" data-reveal>Ce que fera Réputia</h2>
      <div class="mt-8 grid gap-5 md:grid-cols-2">
        {
          [
            { t: 'Demande d\'avis au bon moment', d: 'Deux heures après la prestation — le client est encore content, et c\'est le meilleur moment pour lui demander.' },
            { t: 'Mécontent filtré en privé', d: 'Un client frustré est orienté vers un message privé pour vous plutôt que vers une note publique. Vous apprenez le problème au lieu de le subir en public.' },
            { t: 'Réponse à tous les avis', d: 'Chaque avis reçoit une réponse, rédigée dans votre ton et validée par vous. Un avis sans réponse fait fuir autant qu\'une mauvaise note.' },
            { t: 'Tableau de bord concurrentiel', d: 'Votre note et votre volume d\'avis face à ceux des concurrents locaux : vous savez ce qui reste à faire.' },
          ].map((f) => (
            <div class="rounded-2xl bg-alliance-dark-2 border border-white/10 p-6" data-reveal>
              <h3 class="font-semibold text-white">{f.t}</h3>
              <p class="mt-2 text-sm text-white/70 leading-relaxed">{f.d}</p>
            </div>
          ))
        }
      </div>
      <div class="mt-10 rounded-3xl border border-alliance-blue/30 bg-gradient-to-br from-alliance-dark-2 to-alliance-dark p-8 text-center" data-reveal>
        <h2 class="font-display text-2xl font-bold text-white">Vos concurrents ont plus d\'avis que vous ?</h2>
        <p class="mt-3 text-white/70 max-w-xl mx-auto">Sur Google, l'établissement avec le plus d'avis récents et répondus capte les clients. Réputia installe la machine qui les accumule pour vous, semaine après semaine.</p>
        <a href="/contact/" class="btn-primary mt-6 inline-block px-8 py-3 rounded-lg font-semibold">Être prévenu à la sortie</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
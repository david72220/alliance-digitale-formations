var frame=document.getElementById("frame");
var shead=document.getElementById("shead");
var scTitle=document.getElementById("scTitle");
var scSub=document.getElementById("scSub");
var card=document.getElementById("card");
var badge=document.getElementById("badge");
var cardT=document.getElementById("cardT");
var cardE=document.getElementById("cardE");
var wires=document.getElementById("wires");
var linesG=document.getElementById("lines");
var nodesHolder=document.getElementById("nodesHolder");
var prog=document.getElementById("prog");
var pillsEl=document.getElementById("pills");
var schemaBox=document.getElementById("schemaBox");

var RM=window.matchMedia&&window.matchMedia("(prefers-reduced-motion: reduce)").matches;
var timer=null,current=0;
var curNodes={},curLinks=[],curSegs=[],curText=[],prevLit={},scNodes={};

function fit(){
  var s=Math.min(window.innerWidth/560,window.innerHeight/980);
  frame.style.transform="translate(-50%,-50%) scale("+s+")";
}
window.addEventListener("resize",fit);
fit();

function mk(tag,attrs){var el=document.createElementNS(NS,tag);for(var k in attrs)el.setAttribute(k,attrs[k]);return el;}
function schedule(ms,fn){clearTimeout(timer);timer=setTimeout(fn,ms);}

/* trace d'une liaison : cible plus bas -> descente / palier / descente ; même rangée -> horizontale */
function pathFor(a,b){
  if(!a||!b)return"";
  var y=a.y+NH/2;
  if(b.y===a.y){
    return b.x>a.x?"M"+(a.x+NWD)+" "+y+" H"+b.x:"M"+a.x+" "+y+" H"+(b.x+NWD);
  }
  var sx=a.x+NWD/2,sy=a.y+NH,tx=b.x+NWD/2,ty=b.y;
  if(sx===tx)return"M"+sx+" "+sy+" V"+ty;
  var my=sy+(ty-sy)/2;
  return"M"+sx+" "+sy+" V"+my+" H"+tx+" V"+ty;
}

/* pastilles */
var pills=[];
DATA.forEach(function(sc,i){
  var b=document.createElement("button");
  b.type="button";b.className="pill";b.textContent=sc.pastille;
  b.addEventListener("click",function(){goTo(i);});
  pillsEl.appendChild(b);pills.push(b);
});
function updatePills(){pills.forEach(function(p,i){p.classList.toggle("cur",i===current);});}

/* ajustement du texte : jamais coupé hors du nœud, taille réduite si besoin */
function fitText(el,max,min){
  el.style.fontSize="";
  var s=max,guard=0;
  while(guard++<24&&((el.scrollWidth>el.clientWidth+1)||(el.scrollHeight>el.clientHeight+1))&&s>min){
    s-=0.5;el.style.fontSize=s+"px";
  }
}
function fitAll(){curText.forEach(function(a){fitText(a[0],a[1],a[2]);});}

function renderScene(sc){
  nodesHolder.innerHTML="";linesG.innerHTML="";prog.innerHTML="";
  curNodes={};curLinks=[];curSegs=[];curText=[];prevLit={};scNodes={};
  var pos={};
  sc.noeuds.forEach(function(n){
    pos[n.id]={x:COL[n.col],y:TOPY+(n.r-1)*PITCH};
    scNodes[n.id]=n;
  });
  sc.liens.forEach(function(pr){
    var p=mk("path",{d:pathFor(pos[pr[0]],pos[pr[1]]),"class":"wire"});
    linesG.appendChild(p);curLinks.push({el:p,src:pr[0],tgt:pr[1]});
  });
  sc.noeuds.forEach(function(n){
    var el=document.createElement("div");
    el.className="node"+(n.etat==="prevu"?" prevu":"");
    el.style.left=pos[n.id].x+"px";el.style.top=pos[n.id].y+"px";
    el.style.setProperty("--c",n.cle?"#ffd447":(n.couleur||TQ));
    var d=document.createElement("span");d.className="nstate";d.style.background=STATEC[n.etat];
    var ic=document.createElement("div");ic.className="ic";
    ic.innerHTML='<svg viewBox="0 0 24 24">'+(ICONS[n.ic]||"")+"</svg>";
    var tx=document.createElement("div");tx.className="ntx";
    var t=document.createElement("div");t.className="nt";t.textContent=n.t;
    var s=document.createElement("div");s.className="ns";s.textContent=n.s;
    tx.appendChild(t);tx.appendChild(s);
    el.appendChild(d);el.appendChild(ic);el.appendChild(tx);
    nodesHolder.appendChild(el);curNodes[n.id]=el;
    curText.push([t,12.5,9.5],[s,10,8]);
  });
  sc.etapes.forEach(function(){
    var sg=document.createElement("div");sg.className="seg";
    prog.appendChild(sg);curSegs.push(sg);
  });
  fitAll();
}

function setCard(b,t,e){
  badge.textContent=b;cardT.textContent=t;cardE.textContent=e||"";
  if(!RM){card.classList.remove("in");void card.offsetWidth;card.classList.add("in");}
}

function pulse(path,delay){
  if(RM)return;
  var L=path.getTotalLength();
  var p0=path.getPointAtLength(0);
  var dot=mk("circle",{r:"3","class":"pulse-dot",cx:p0.x,cy:p0.y,opacity:"0"});
  linesG.appendChild(dot);
  var t0=performance.now();
  function fr(t){
    var e=t-t0-delay;
    if(e<0){requestAnimationFrame(fr);return;}
    dot.setAttribute("opacity","1");
    if(e>=PULSE_MS){dot.remove();return;}
    var p=path.getPointAtLength(L*(e/PULSE_MS));
    dot.setAttribute("cx",p.x);dot.setAttribute("cy",p.y);
    requestAnimationFrame(fr);
  }
  requestAnimationFrame(fr);
}

/* peinture : on = étape courante, done = étapes passées, sinon terne */
function paint(sc,seen,freshIds,isFinal,stepIdx){
  var st=isFinal?null:sc.etapes[stepIdx];
  setCard(isFinal?"\u21bb":st.n,isFinal?sc.final:st.t,isFinal?"":st.e);
  var freshLinks=[];
  curLinks.forEach(function(o,i){
    var lit=isFinal||!!(seen[o.src]&&seen[o.tgt]);
    o.el.classList.toggle("lit",lit);
    if(lit&&!prevLit[i])freshLinks.push(o.el);
    prevLit[i]=lit;
  });
  freshLinks.forEach(function(p,i){pulse(p,i*PULSE_GAP);});
  for(var id in curNodes){
    var n=scNodes[id];
    var cls="node"+(n.etat==="prevu"?" prevu":"");
    if(isFinal||(freshIds&&freshIds.indexOf(id)>=0))cls+=" on";
    else if(seen[id])cls+=" done";
    curNodes[id].className=cls;
  }
  curSegs.forEach(function(sg,j){
    sg.className="seg"+(isFinal||j<stepIdx?" past":(j===stepIdx?" cur":""));
  });
}

function startScene(i){
  current=i;updatePills();
  var sc=DATA[i];
  scTitle.textContent=sc.titre;scSub.textContent=sc.sous_titre;
  renderScene(sc);
  var seen={},idx=0;
  schedule(0,function step(){
    if(idx<sc.etapes.length){
      var stp=sc.etapes[idx];
      stp.noeuds.forEach(function(id){seen[id]=1;});
      paint(sc,seen,stp.noeuds,false,idx);
      idx++;
      schedule(STEP_MS,step);
    }else{
      paint(sc,seen,null,true,idx);
      schedule(FINAL_MS,function(){fadeTo(idx===0?0:(i+1)%DATA.length);});
    }
  });
}

function fadeTo(next){
  shead.classList.add("faded");card.classList.add("faded");schemaBox.classList.add("faded");
  schedule(FADE_MS,function(){
    shead.classList.remove("faded");card.classList.remove("faded");schemaBox.classList.remove("faded");
    startScene(next);
  });
}

function goTo(i){
  if(RM){showStatic(i);return;}
  shead.classList.add("faded");card.classList.add("faded");schemaBox.classList.add("faded");
  schedule(FADE_MS,function(){
    shead.classList.remove("faded");card.classList.remove("faded");schemaBox.classList.remove("faded");
    startScene(i);
  });
}

/* prefers-reduced-motion : chaque scène en état final, aucune animation */
function showStatic(i){
  current=i;updatePills();
  var sc=DATA[i];
  scTitle.textContent=sc.titre;scSub.textContent=sc.sous_titre;
  renderScene(sc);
  var seen={};
  sc.noeuds.forEach(function(n){seen[n.id]=1;});
  paint(sc,seen,null,true,sc.etapes.length);
}

document.addEventListener("keydown",function(e){
  if(e.key==="ArrowLeft")goTo((current+DATA.length-1)%DATA.length);
  else if(e.key==="ArrowRight")goTo((current+1)%DATA.length);
});

if(document.fonts&&document.fonts.ready)document.fonts.ready.then(fitAll);
if(RM)showStatic(0);else startScene(0);
})();
</script>

<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="Comment un second cerveau travaille pour votre entreprise : le pilotage d'un projet IA, scène par scène. Présentation animée par Alliance Digitale.">
<title>Le second cerveau, animé | Alliance Digitale</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Inter:wght@400;600&display=swap" rel="stylesheet">
<style is:global>
  :root{
    --turq:#3b97d3; --wire:#1e5a86; --nodebg:rgba(7,13,24,.78);
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{height:100%}
  body{
    background:#070d18; overflow:hidden;
    font-family:Inter,system-ui,-apple-system,sans-serif;
  }
  .stage{position:fixed;inset:0;background:#070d18}
  .frame{
    width:540px;height:960px;position:absolute;left:50%;top:50%;
    transform-origin:center center; overflow:hidden;
    background:linear-gradient(180deg,#070d18 0%,#0b1120 55%,#10314f 100%);
  }
  /* décor : parallélogrammes translucides */
  .pgram{position:absolute;pointer-events:none}
  .p1{
    width:420px;height:560px;left:-190px;top:230px;
    background:linear-gradient(135deg,rgba(59,151,211,.22),rgba(10,60,100,.05));
    transform:skewY(-16deg) skewX(-8deg);border-radius:40px;
  }
  .p2{
    width:360px;height:520px;right:-200px;top:-160px;
    background:linear-gradient(315deg,rgba(59,151,211,.20),rgba(10,40,70,.04));
    transform:skewY(-14deg) skewX(10deg);border-radius:40px;
  }
  .p3{
    width:380px;height:420px;right:-160px;bottom:-180px;
    background:linear-gradient(315deg,rgba(158,33,20,.20),rgba(40,10,6,.04));
    transform:skewY(12deg) skewX(-6deg);border-radius:40px;
  }
  .dots{
    position:absolute;inset:0;pointer-events:none;
    background-image:radial-gradient(circle,rgba(255,255,255,.07) 1px,transparent 1.6px);
    background-size:26px 26px;
  }
  .inner{
    position:absolute;inset:0;padding:26px 0 14px;display:flex;flex-direction:column;
  }
  /* ligne de marque */
  .brand{
    display:flex;align-items:center;gap:8px;margin:0 24px;
    color:rgba(255,255,255,.92);font-size:14px;font-weight:600;letter-spacing:.04em;
  }
  .brand .sq{width:10px;height:10px;background:var(--turq);border-radius:2px;display:inline-block;flex:none}
  /* pastilles de scènes */
  .pills{display:flex;gap:6px;margin:12px 24px 0}
  .pill{
    font-family:Inter,system-ui,sans-serif;font-size:12px;font-weight:600;line-height:1.2;
    color:rgba(255,255,255,.8);background:rgba(7,13,24,.55);
    border:1px solid var(--wire);border-radius:999px;padding:4px 2px;cursor:pointer;
    flex:1;text-align:center;transition:background .2s,color .2s,border-color .2s;
  }
  .pill.cur{background:var(--turq);border-color:var(--turq);color:#04121f}
  /* titre de scène */
  .shead{margin:14px 24px 0;transition:opacity .2s ease}
  .st1{
    font-family:Poppins,system-ui,sans-serif;font-weight:700;
    font-size:34px;line-height:1.08;color:#fff;letter-spacing:-.01em;
  }
  .st2{margin-top:3px;color:var(--turq);font-weight:600;font-size:16px;line-height:1.3}
  /* carte d'étape */
  .card{
    margin:16px 24px 0;display:flex;align-items:center;gap:12px;
    border:1px solid rgba(59,151,211,.75);background:rgba(10,25,42,.6);
    border-radius:14px;padding:12px 14px;min-height:74px;transition:opacity .2s ease;
  }
  .card.in{animation:cardIn .2s ease-out}
  @keyframes cardIn{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:none}}
  .badge{
    flex:none;width:38px;height:38px;border-radius:8px;background:var(--turq);
    color:#04121f;font-family:Poppins,system-ui,sans-serif;font-weight:700;font-size:17px;
    display:flex;align-items:center;justify-content:center;
  }
  .ct-t{color:#fff;font-weight:600;font-size:16px;line-height:1.25}
  .ct-e{color:rgba(255,255,255,.78);font-weight:400;font-size:13px;line-height:1.35;margin-top:3px}
  .faded{opacity:0}
  /* barre de progression */
  .prog{display:flex;gap:6px;margin:14px 24px 0}
  .seg{
    flex:1;height:7px;border-radius:4px;background:rgba(59,151,211,.3);
    transition:background .3s,box-shadow .3s;
  }
  .seg.past{background:var(--turq)}
  .seg.cur{background:var(--turq);box-shadow:0 0 8px rgba(59,151,211,.55);animation:breathe 1.2s infinite}
  @keyframes breathe{0%,100%{opacity:1}50%{opacity:.7}}
  /* schéma */
  .schema{position:relative;margin-top:26px;height:500px;flex:none;transition:opacity .2s ease}
  #wires{position:absolute;inset:0;width:100%;height:100%}
  .wire{stroke:var(--wire);stroke-width:1.5;fill:none;transition:stroke .3s,filter .3s}
  .wire.lit{stroke:var(--turq);filter:drop-shadow(0 0 3px rgba(59,151,211,.7))}
  .pulse-dot{fill:var(--turq);filter:drop-shadow(0 0 5px rgba(59,151,211,.95))}
  /* nœuds */
  .node{
    position:absolute;width:150px;height:50px;border-radius:10px;
    background:var(--nodebg);border:1px solid var(--wire);
    display:flex;align-items:center;gap:6px;padding:0 6px;
    opacity:.5;transition:opacity .3s,border-color .3s,box-shadow .3s;
    min-width:0;overflow:hidden;
  }
  .node .ic{
    flex:none;width:20px;height:20px;border-radius:6px;color:var(--c,var(--turq));
    background:rgba(255,255,255,.07);display:flex;align-items:center;justify-content:center;
    transition:background .3s,color .3s;
  }
  .node .ic svg{width:13px;height:13px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
  .nt{
    min-width:0;color:#fff;font-family:Poppins,system-ui,sans-serif;font-weight:600;
    font-size:12.5px;line-height:15px;white-space:nowrap;overflow:hidden;
  }
  .ns{
    min-width:0;color:rgba(255,255,255,.7);font-size:10px;line-height:12px;
    max-height:24px;overflow:hidden;
  }
  .ntx{min-width:0;display:flex;flex-direction:column;gap:1px;flex:1;padding-right:8px}
  .nstate{
    position:absolute;top:5px;right:5px;width:7px;height:7px;border-radius:50%;
    z-index:2;flex:none;
  }
  .node.done{opacity:1;border-width:1.5px;border-color:var(--c,var(--turq))}
  .node.on{
    opacity:1;border-width:1.5px;border-color:var(--turq);
    box-shadow:0 0 18px rgba(59,151,211,.45),0 0 6px rgba(59,151,211,.6);
  }
  .node.on .ic{background:var(--c,var(--turq));color:#04121f}
  .node.prevu{border-style:dashed}
  /* légende */
  .legend{
    display:flex;justify-content:center;gap:14px;margin:auto 24px 0;
    font-size:11px;color:rgba(255,255,255,.65);white-space:nowrap;
  }
  .legend span{display:flex;align-items:center;gap:5px}
  .legend i{width:7px;height:7px;border-radius:50%;display:inline-block;flex:none}
  @media (prefers-reduced-motion:reduce){
    *{transition:none!important;animation:none!important}
  }
</style>
</head>
<body>
<div class="stage">
  <div class="frame" id="frame">
    <div class="pgram p1"></div>
    <div class="pgram p2"></div>
    <div class="pgram p3"></div>
    <div class="dots"></div>
    <div class="inner">
      <div class="brand"><span class="sq"></span>Alliance Digitale · Le second cerveau, animé</div>
      <div class="pills" id="pills"></div>
      <div class="shead" id="shead">
        <div class="st1" id="scTitle"></div>
        <div class="st2" id="scSub"></div>
      </div>
      <div class="card" id="card">
        <div class="badge" id="badge"></div>
        <div class="ntx">
          <div class="ct-t" id="cardT"></div>
          <div class="ct-e" id="cardE"></div>
        </div>
      </div>
      <div class="prog" id="prog"></div>
      <div class="schema" id="schemaBox">
        <svg id="wires" viewBox="0 0 540 500" preserveAspectRatio="none">
          <g id="lines"></g>
        </svg>
        <div id="nodesHolder" style="position:absolute;inset:0"></div>
      </div>
      <div class="legend">
        <span><i style="background:#3ddc84"></i>en service</span>
        <span><i style="background:#ffb347"></i>codé, pas en prod</span>
        <span><i style="background:#8a84b0"></i>prévu · état au 09/11/2026</span>
      </div>
    </div>
  </div>
</div>

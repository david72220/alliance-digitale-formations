---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FiberFrame from '../components/FiberFrame.astro';
import heroImage from '../assets/hero-formation-ia.png';
import { getCaseStudies, getResources } from '../lib/notion.ts';

const studies = await getCaseStudies();
const resources = await getResources();

const heroStudies = studies.slice(0, 3);
const heroResources = resources.slice(0, 6);

// Sites démo TPE
const tpeDemos = [
  { url: 'https://demo-plombier-ten.vercel.app/', label: 'Plombier', emoji: '🔧', desc: 'Prise de RDV, devis express, suivi chantier' },
  { url: 'https://demo-paysagiste-one.vercel.app/', label: 'Paysagiste', emoji: '🌿', desc: 'Galerie réalisations, devis en ligne, planning' },
  { url: 'https://demo-couvreur.vercel.app/', label: 'Couvreur', emoji: '🏠', desc: 'Portfolio toitures, urgence fuite, devis' },
  { url: 'https://demo-electricien-alpha.vercel.app/', label: 'Électricien', emoji: '⚡', desc: 'Certifications, interventions, devis en ligne' },
];

// Parcours d'intégration IA — 4 phases, 4 livrables (affiché dans le hero)
const parcoursSteps = [
  {
    num: 'C1',
    titre: 'Diagnostic rapide',
    texte: "Audit IA express sur le cas d'usage que vous choisissez : validez la valeur de l'IA sur une situation réelle de votre entreprise, en quelques semaines.",
    livrable: 'Prototype fonctionnel + rapport d\'opportunités',
  },
  {
    num: 'C2',
    titre: 'Montée en compétence & analyse',
    texte: 'Formation de vos équipes et audit complet de vos processus existants.',
    livrable: 'Équipes formées + cartographie des processus',
  },
  {
    num: 'C3',
    titre: 'Déploiement sur mesure',
    texte: 'Second cerveau sécurisé (architecture RAG), accès stricts selon vos habilitations.',
    livrable: 'Second cerveau RAG opérationnel',
  },
  {
    num: 'C4',
    titre: 'Pérennisation',
    texte: 'Formation avancée, veille technologique, améliorations continues.',
    livrable: "Plan d'évolution + veille mensuelle",
  },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "C'est quoi exactement l'accompagnement Alliance Digitale ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Un parcours balisé en 4 phases pour votre PME : diagnostic express (C1), montée en compétence et analyse (C2), déploiement sur mesure type second cerveau (C3), puis pérennisation (C4). Chaque phase produit un livrable concret et se décide indépendamment des suivantes."
      }
    },
    {
      "@type": "Question",
      "name": "Combien de temps dure un diagnostic ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Quelques semaines. L'audit express C1 démarre sur un cas d'usage que vous choisissez et se conclut par un prototype fonctionnel et un rapport d'opportunités — sans engagement sur la suite."
      }
    },
    {
      "@type": "Question",
      "name": "Faut-il des compétences en IA en interne ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Non, aucune. Les formations repartent de zéro et sont appliquées à votre métier. Chaque livrable est pensé pour être utilisé par vos équipes sans bagage technique."
      }
    },
    {
      "@type": "Question",
      "name": "Je n'y connais rien en IA, c'est un problème ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Non, c'est même préférable. Nos formations partent de zéro et sont conçues pour des professionnels non-techniques. Chaque session est appliquée à votre métier : vous repartez avec des outils et méthodes immédiatement utilisables."
      }
    },
    {
      "@type": "Question",
      "name": "Ça concerne quelles entreprises ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Toute PME avec salariés en Sarthe et dans les Pays de la Loire : artisans du BTP, commerces, professions libérales, santé, immobilier, restauration, transport… Si vous avez des tâches répétitives, nous pouvons les automatiser."
      }
    },
    {
      "@type": "Question",
      "name": "Qu'est-ce que l'AI Act et pourquoi c'est important pour ma PME ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "L'AI Act est le règlement européen sur l'IA, applicable à partir d'août 2026. Il impose des obligations aux entreprises qui utilisent des systèmes d'IA, même via ChatGPT. Nous vous aidons à identifier vos risques et à vous mettre en conformité avant l'échéance."
      }
    },
    {
      "@type": "Question",
      "name": "Combien ça coûte ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "L'audit initial est gratuit (30 min). Un financement OPCO est possible selon votre branche. L'accompagnement complet est sur devis après l'audit. Le challenge 5 jours et l'outil de sécurité documentaire sont gratuits."
      }
    }
  ]
};
---

<Layout
  title="Parcours IA PME : de l'audit au second cerveau"
  description="Un parcours IA balisé pour votre PME : diagnostic express, montée en compétence, second cerveau sécurisé, pérennisation. Chaque phase livre un livrable concret."
  jsonLd={faqLd}
>
  <Header />

  <main class="flex-1">
    <!-- ============================================================ -->
    <!-- 1 · HERO + PARCOURS FUSIONNÉS (badge, H1, stepper C1→C4, vidéo, encart, chips) -->
    <!-- ============================================================ -->
    <section class="relative overflow-hidden bg-alliance-dark-2 pt-24 pb-16 px-4 sm:px-6 lg:px-8">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-alliance-blue/10 via-transparent to-transparent"></div>
      <div class="relative max-w-7xl mx-auto">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div class="max-w-3xl">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-alliance-orange/30 bg-alliance-orange/10 text-alliance-orange text-xs font-semibold uppercase tracking-wider mb-6" data-hero-anim="badge">
              AI Act · Conformité dès août 2026
            </div>

            <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight" data-hero-anim="title">
              <span class="hero-line">L'IA au service de votre PME,</span>
              <span class="gradient-text hero-line">sans complexité technique</span>
            </h1>

            <p class="text-lg sm:text-xl text-white/70 max-w-2xl mb-10 leading-relaxed" data-hero-anim="lead">
              Alliance Digitale accompagne les PME avec salariés en Sarthe dans la conformité AI Act,
              l'adoption de l'IA générative et l'automatisation des tâches du quotidien.
            </p>

            <div class="flex flex-col sm:flex-row items-start gap-4" data-hero-anim="cta">
              <a href="/accompagnement/" class="btn-primary text-base px-8 py-4">Découvrir l'accompagnement</a>
              <a href="/contact/" class="btn-secondary text-base px-8 py-4">Prendre rendez-vous</a>
            </div>

            <div class="mt-12 flex flex-wrap items-center gap-6 text-sm text-white/65" data-hero-anim="stats">
              <span class="flex items-center gap-2">
                <svg class="w-5 h-5 text-alliance-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span data-count="23">23</span>&nbsp;sessions animées chez les clients
              </span>
              <span class="flex items-center gap-2">
                <svg class="w-5 h-5 text-alliance-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                <span data-count="168">168</span>&nbsp;apprenants formés
              </span>
              <span class="flex items-center gap-2">
                <svg class="w-5 h-5 text-alliance-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
                <span data-count="95" data-count-suffix=" %">95 %</span>&nbsp;de satisfaction
              </span>
            </div>
          </div>

          <div class="relative hidden lg:block" data-hero-parallax>
            <div class="absolute -inset-4 bg-gradient-to-br from-alliance-blue/20 to-alliance-orange/20 rounded-3xl blur-2xl"></div>
            <FiberFrame radius={16} class="relative block">
              <Image
                src={heroImage}
                alt="Formation IA et automatisation en Sarthe avec Alliance Digitale"
                widths={[480, 768, 1024, 1280]}
                sizes="(min-width: 1024px) 50vw, 100vw"
                formats={['avif', 'webp']}
                quality={75}
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="relative rounded-2xl border border-white/10 shadow-2xl w-full object-cover"
              />
            </FiberFrame>
          </div>
        </div>

        <!-- PARCOURS C1→C4 fusionné dans le hero -->
        <div id="parcours" class="mt-14 scroll-mt-28">
          <p class="text-sky-400 text-xs font-bold uppercase tracking-widest mb-4" data-reveal>Le parcours — 4 phases balisées, 4 livrables concrets</p>
          <div class="grid grid-cols-1 md:grid-cols-4 gap-4 md:gap-0" data-reveal>
            {parcoursSteps.map((step, i) => (
              <div class={i < parcoursSteps.length - 1 ? 'relative md:mr-6' : 'relative'}>
                {i < parcoursSteps.length - 1 && (
                  <span class="hidden md:flex absolute top-1/2 -translate-y-1/2 -right-[18px] z-10 w-6 h-6 items-center justify-center text-alliance-blue" aria-hidden="true">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                  </span>
                )}
                <div class="h-full rounded-xl border border-alliance-blue/30 bg-white/5 p-5 hover:border-alliance-blue/60 transition-colors">
                  <div class="font-display text-sm font-bold text-sky-300 tracking-widest">{step.num}</div>
                  <p class="font-display text-lg font-bold text-white mt-1.5 mb-2 leading-snug">{step.titre}</p>
                  <p class="text-sm text-white/65 leading-relaxed mb-3">{step.texte}</p>
                  <span class="block text-xs text-sky-300 bg-sky-500/10 border border-sky-500/25 rounded-lg px-2.5 py-1.5">
                    <strong class="text-white font-semibold">Livrable :</strong> {step.livrable}
                  </span>
                </div>
              </div>
            ))}
          </div>

          <!-- Vidéo + encart « Par où commencer ? » -->
          <div class="grid lg:grid-cols-5 gap-4 mt-6" data-reveal>
            <div class="lg:col-span-3">
              <div
                id="video-parcours"
                data-video-id="yXdAcug6U1o"
                class="relative w-full overflow-hidden rounded-2xl border border-dashed border-sky-400/50 bg-gradient-to-br from-alliance-blue/10 via-alliance-dark-2 to-alliance-orange/10"
                style="aspect-ratio: 16 / 9;"
              >
                <button
                  type="button"
                  id="video-facade-btn"
                  class="absolute inset-0 w-full h-full flex flex-col items-center justify-center gap-3 cursor-pointer group"
                  aria-label="Charger la vidéo de présentation du parcours"
                >
                  <span class="w-14 h-14 rounded-full bg-alliance-blue text-alliance-dark flex items-center justify-center shadow-lg group-hover:scale-105 transition-transform">
                    <svg class="w-6 h-6 ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5.14v13.72c0 .81.87 1.3 1.55.86l10.4-6.86a1 1 0 000-1.72L9.55 4.28A1 1 0 008 5.14z"/></svg>
                  </span>
                  <span class="font-semibold text-white">Le parcours en vidéo</span>
                  <span class="text-xs text-white/60 max-w-sm text-center px-4">Vidéo à venir — emplacement réservé. Rien ne se charge avant votre clic.</span>
                </button>
                <div id="video-note" class="hidden absolute inset-0 flex items-center justify-center text-center px-6 text-sm text-white/80">
                  La vidéo arrive bientôt — demandez une démonstration personnalisée avec vos propres documents.
                </div>
              </div>
            </div>
            <div class="lg:col-span-2 rounded-2xl border border-white/10 bg-white/5 p-6">
              <p class="font-display text-lg font-bold text-white mb-3">Par où commencer ?</p>
              <ul class="space-y-2.5 text-sm text-white/70 leading-relaxed">
                <li><strong class="text-white">C1 sans engagement</strong> : l'audit express démarre sur le cas d'usage que vous choisissez.</li>
                <li><strong class="text-white">Vous validez la valeur</strong> de l'IA sur un cas réel avant de décider de la suite.</li>
                <li><strong class="text-white">Chaque phase se facture seule</strong> — aucun forfait imposé.</li>
              </ul>
              <a href="/accompagnement/" class="btn-primary mt-5 text-sm px-5 py-2.5">Démarrer C1 — l'audit express</a>
            </div>
          </div>

          <!-- Chips outils gratuits -->
          <div class="mt-8 flex flex-wrap gap-3" data-reveal>
            <a href="/securite-ia/" class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-white/15 bg-white/5 text-sm text-sky-300 hover:bg-white/10 hover:text-white transition">
              🛡️ <strong class="text-white font-semibold">Sécurité des documents</strong> — testez (gratuit)
            </a>
            <a href="/challenge/" class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-white/15 bg-white/5 text-sm text-sky-300 hover:bg-white/10 hover:text-white transition">
              ⏱️ Challenge IA <strong class="text-white font-semibold">5 jours</strong> (gratuit)
            </a>
            <a href="/ressources/" class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-white/15 bg-white/5 text-sm text-sky-300 hover:bg-white/10 hover:text-white transition">
              📚 <strong class="text-white font-semibold">Micro-cours</strong> IA & cybersécurité
            </a>
            <a href="/pilotai/" class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-white/15 bg-white/5 text-sm text-sky-300 hover:bg-white/10 hover:text-white transition">
              🚀 Découvrez <strong class="text-white font-semibold">PilotAI</strong>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 2 · RÉALISATIONS COMPACTES — bande 3+3 -->
    <!-- ============================================================ -->

    <!-- ============================================================ -->
    <!-- 3 · PROFILS — PME renvoie au parcours · TPE conservé -->
    <!-- ============================================================ -->
    <section data-cv class="pb-16 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto">
        <!-- Titre du groupe -->
        <div class="text-center mb-6">
          <p class="text-sky-400 text-sm font-bold uppercase tracking-widest mb-2">Accompagnement</p>
          <h2 class="font-display text-2xl sm:text-3xl font-bold text-white">Choisissez votre profil</h2>
        </div>

        <!-- Barre d'onglets -->
        <div class="tab-buttons" id="tabs-accompagnement">
          <button class="tab-btn active" data-group="accompagnement" data-tab="pme" onclick="switchTabGroup('accompagnement', 'pme')">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21h6"/></svg>
            Accompagnement PME
          </button>
          <button class="tab-btn" data-group="accompagnement" data-tab="tpe" onclick="switchTabGroup('accompagnement', 'tpe')">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.95-8.95a1.5 1.5 0 012.1 0L21.75 12M3 12v7.5A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 19.5V12"/></svg>
            Accompagnement TPE
          </button>
        </div>

        <!-- Contenu PME : renvoi au parcours C1→C4 (fin du doublon) -->
        <div class="tab-content active" data-group="accompagnement" id="tab-accompagnement-pme">
          <div class="tab-panel tab-panel--pme">
            <div class="grid lg:grid-cols-2 gap-10 items-start">
              <div>
                <div class="flex items-center gap-2 mb-4">
                  <svg class="w-7 h-7 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21h6"/></svg>
                  <h3 class="font-display text-2xl sm:text-3xl font-bold text-white">
                    Accompagnement PME
                  </h3>
                </div>

                <p class="text-white/80 text-base mb-6 leading-relaxed">
                  Vous dirigez une PME avec salariés en Sarthe ? Toute la démarche est décrite en haut de cette page :
                  quatre phases balisées — diagnostic, montée en compétence, déploiement, pérennisation — et vous décidez
                  de la suite après chaque livrable.
                </p>

                <div class="flex flex-wrap gap-3">
                  <a href="#parcours" class="btn-primary inline-flex items-center gap-2">
                    Voir le parcours en haut de page
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/></svg>
                  </a>
                  <a href="/accompagnement/" class="btn-secondary inline-flex items-center gap-2">
                    Détail de l'offre d'accompagnement
                  </a>
                </div>
              </div>

              <div class="space-y-3">
                {parcoursSteps.map((step) => (
                  <div class="flex items-start gap-3 p-3.5 rounded-lg border border-sky-500/20 bg-sky-900/20">
                    <span class="font-display text-xs font-bold text-sky-300 tracking-widest mt-1 shrink-0">{step.num}</span>
                    <div>
                      <h4 class="font-semibold text-white text-sm">{step.titre}</h4>
                      <p class="text-xs text-white/60 mt-0.5">Livrable : {step.livrable}</p>
                    </div>
                  </div>
                ))}
                <p class="text-xs text-white/50">
                  Déjà convaincu ? <a href="/accompagnement/" class="text-sky-400 hover:text-white transition-colors">Voir l'offre d'accompagnement</a>.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Contenu TPE -->
        <div class="tab-content" data-group="accompagnement" id="tab-accompagnement-tpe">
          <div class="tab-panel tab-panel--tpe">
            <div class="grid lg:grid-cols-2 gap-10 items-start">
              <div>
                <div class="flex items-center gap-2 mb-4">
                  <svg class="w-7 h-7 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.95-8.95a1.5 1.5 0 012.1 0L21.75 12M3 12v7.5A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 19.5V12"/></svg>
                  <h3 class="font-display text-2xl sm:text-3xl font-bold text-white">
                    Accompagnement TPE
                  </h3>
                </div>

                <p class="text-white/80 text-base mb-6 leading-relaxed">
                  Vous êtes auto-entrepreneur, artisan, ou dirigez une petite entreprise de moins de 10 salariés ?
                  Notre offre TPE est conçue pour vous : un <strong class="text-white">site vitrine professionnel</strong> optimisé pour votre métier,
                  couplé à une <strong class="text-white">stratégie d'automatisation adaptée</strong> à vos moyens.
                </p>

                <p class="text-white/70 text-sm mb-6 leading-relaxed">
                  Fini les sites génériques qui ne convertissent pas. Nous créons pour vous un site qui reflète votre savoir-faire,
                  qui apparaît quand vos clients vous cherchent, et qui intègre les bons outils pour vous faire gagner du temps au quotidien.
                </p>

                <ul class="space-y-3 mb-8">
                  <li class="flex items-start gap-3 text-white/80">
                    <svg class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    <span><strong class="text-white">Site professionnel sur-mesure</strong> adapté à votre métier et votre territoire</span>
                  </li>
                  <li class="flex items-start gap-3 text-white/80">
                    <svg class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    <span><strong class="text-white">SEO local</strong> pour apparaître quand on vous cherche</span>
                  </li>
                  <li class="flex items-start gap-3 text-white/80">
                    <svg class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    <span><strong class="text-white">Prise de rendez-vous</strong> et devis en ligne intégrés</span>
                  </li>
                  <li class="flex items-start gap-3 text-white/80">
                    <svg class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    <span><strong class="text-white">Automatisations</strong> : relances, factures, suivi client</span>
                  </li>
                </ul>


  <Footer />

  <style>
    /* Perf : le navigateur saute le rendu des sections hors écran jusqu'au scroll */
    section[data-cv] {
      content-visibility: auto;
      contain-intrinsic-size: auto 700px;
    }
  </style>
  <script is:inline>
    function switchTabGroup(group, tabId) {
      // Désactiver tous les onglets du même groupe
      document.querySelectorAll('.tab-btn[data-group="' + group + '"]').forEach(function(btn) {
        btn.classList.remove('active');
      });
      document.querySelectorAll('.tab-content[data-group="' + group + '"]').forEach(function(panel) {
        panel.classList.remove('active');
      });

      // Activer l'onglet sélectionné
      document.querySelector('.tab-btn[data-group="' + group + '"][data-tab="' + tabId + '"]').classList.add('active');
      document.getElementById('tab-' + group + '-' + tabId).classList.add('active');
    }

    // Vidéo « click-to-load » : rien ne se charge avant le clic
    (function () {
      var videoBox = document.getElementById('video-parcours');
      var facadeBtn = document.getElementById('video-facade-btn');
      var note = document.getElementById('video-note');
      if (!videoBox || !facadeBtn) return;
      facadeBtn.addEventListener('click', function () {
        if (videoBox.dataset.loaded) return;
        videoBox.dataset.loaded = '1';
        var id = (videoBox.getAttribute('data-video-id') || '').trim();
        if (id) {
          var iframe = document.createElement('iframe');
          iframe.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0';
          iframe.title = 'Présentation du parcours IA — Alliance Digitale';
          iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
          iframe.referrerPolicy = 'strict-origin-when-cross-origin';
          iframe.allowFullscreen = true;
          iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0;';
          videoBox.replaceChild(iframe, facadeBtn);
        } else if (note) {
          facadeBtn.classList.add('hidden');
          note.classList.remove('hidden');
        }
      });
    })();
  </script>
</Layout>

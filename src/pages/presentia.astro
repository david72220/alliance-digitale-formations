---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const CAL_URL = import.meta.env.CAL_URL ?? 'https://cal.eu/alliance-digitale/decouverte-30-min';
---

<Layout
  title="Présentia — moins de rendez-vous manqués | Alliance Digitale"
  description="Confirmations par email, rappels SMS à J-2 et H-2, re-placement automatique des créneaux libérés. En préparation — prévenez-moi à la sortie."
  image="/images/solutions/presentia.webp"
>
  <Header />
  <main class="flex-1">
    <!-- Hero -->
    <section class="relative overflow-hidden bg-alliance-dark-2">
      <div class="relative mx-auto max-w-7xl px-4 pt-16 pb-14 grid gap-10 lg:grid-cols-2 lg:items-center">
        <div>
          <p class="inline-flex items-center px-3 py-1 rounded-full bg-white/10 text-white/90 text-xs font-bold uppercase tracking-widest border border-white/20" data-hero-anim>Bientôt — en préparation</p>
          <h1 class="mt-4 font-display text-4xl md:text-5xl font-bold text-white" data-hero-anim>Présentia</h1>
          <p class="mt-3 text-xl text-white/80" data-hero-anim>Moins de rendez-vous manqués, plus de créneaux replacés.</p>
          <p class="mt-4 text-white/65 leading-relaxed" data-hero-anim>
            Chaque rendez-vous est confirmé par e-mail, rappelé par SMS la veille et deux heures avant.
            Un client annule ? Le créneau est proposé immédiatement à vos clients en attente.
          </p>
          <div class="mt-6 rounded-2xl border border-white/15 bg-alliance-dark p-5" data-hero-anim>
            <p class="text-white/80 font-semibold">Tarifs prévus</p>
            <ul class="mt-2 space-y-1 text-sm text-white/65">
              <li>Installation : 300 €</li>
              <li>Essentiel : 59 €/mois · Premium : 89 €/mois</li>
            </ul>
            <p class="mt-2 text-xs text-white/45">Offre en préparation — les tarifs définitifs seront confirmés à la sortie.</p>
          </div>
          <div class="mt-6 flex flex-col sm:flex-row gap-4" data-hero-anim>
            <a href="/contact/" class="btn-primary px-8 py-3 rounded-lg font-semibold text-center">Me prévenir à la sortie</a>
          </div>
        </div>
        <div class="rounded-3xl overflow-hidden border border-white/10 shadow-2xl" data-reveal>
          <img
            src="/images/solutions/presentia.webp"
            alt="Gérante de salon de coiffure consultant un rappel de rendez-vous sur son téléphone"
            width="1024"
            height="768"
            loading="eager"
            decoding="async"
            class="w-full aspect-[4/3] object-cover"
          />
        </div>
      </div>
    </section>

    <!-- Ce que fera Présentia -->
    <section class="mx-auto max-w-7xl px-4 py-16">
      <h2 class="font-display text-3xl font-bold text-white" data-reveal>Ce que fera Présentia</h2>
      <div class="mt-8 grid gap-5 md:grid-cols-2">
        {
          [
            { t: 'Confirmation immédiate', d: 'Dès la prise de rendez-vous, le client reçoit un email de confirmation avec tous les détails.' },
            { t: 'Rappels SMS J-2 et H-2', d: 'Le SMS est le canal le plus lu la veille d\'un rendez-vous. C\'est un message transactionnel, pas publicitaire.' },
            { t: 'Re-placement automatique', d: 'Un créneau libéré est proposé aux autres clients en attente — le trou dans l\'agenda se rebouche tout seul.' },
            { t: 'Bilan mensuel des absences', d: 'Combien de rendez-vous manqués, sur quels créneaux, quelle tendance : vous savez où agir.' },
          ].map((f) => (
            <div class="rounded-2xl bg-alliance-dark-2 border border-white/10 p-6" data-reveal>
              <h3 class="font-semibold text-white">{f.t}</h3>
              <p class="mt-2 text-sm text-white/70 leading-relaxed">{f.d}</p>
            </div>
          ))
        }
      </div>
      <div class="mt-10 rounded-3xl border border-alliance-blue/30 bg-gradient-to-br from-alliance-dark-2 to-alliance-dark p-8 text-center" data-reveal>
        <h2 class="font-display text-2xl font-bold text-white">Combien vous coûtent vos rendez-vous manqués ?</h2>
        <p class="mt-3 text-white/70 max-w-xl mx-auto">Faites le calcul avec votre panier moyen : Quatre rendez-vous manqués par mois, c'est souvent plus que l'abonnement. Nous vous aidons à le chiffrer lors de l'échange.</p>
        <a href="/contact/" class="btn-primary mt-6 inline-block px-8 py-3 rounded-lg font-semibold">Être prévenu à la sortie</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>